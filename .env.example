# Server-only Neon Postgres connection string. Never expose this as VITE_DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Required by the custom authentication API migration.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=raees
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash
ADMIN_JWT_SECRET=replace-with-another-long-random-secret
